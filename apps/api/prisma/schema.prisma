generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppMetadata {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("app_metadata")
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique @db.VarChar(100)
  name      String    @db.VarChar(160)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("brands")
}

model Series {
  id        String    @id @default(cuid())
  slug      String    @unique @db.VarChar(120)
  name      String    @db.VarChar(200)
  products  Product[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("series")
}

model Category {
  id       String            @id @default(cuid())
  slug     String            @unique @db.VarChar(100)
  name     String            @db.VarChar(120)
  products ProductCategory[]

  @@map("categories")
}

model Product {
  id                 String            @id @default(cuid())
  slug               String            @unique @db.VarChar(180)
  name               String            @db.VarChar(240)
  characterName      String            @map("character_name") @db.VarChar(160)
  description        String            @db.Text
  priceVnd           Int               @map("price_vnd")
  salePriceVnd       Int?              @map("sale_price_vnd")
  scale              String?           @db.VarChar(30)
  material           String            @db.VarChar(100)
  releaseDate        DateTime?         @map("release_date") @db.Date
  janCode            String            @unique @map("jan_code") @db.VarChar(20)
  isPreorder         Boolean           @default(false) @map("is_preorder")
  preorderDepositVnd Int?              @map("preorder_deposit_vnd")
  isFeatured         Boolean           @default(false) @map("is_featured")
  isNewArrival       Boolean           @default(false) @map("is_new_arrival")
  publishedAt        DateTime?         @map("published_at") @db.Timestamptz(3)
  brandId            String            @map("brand_id")
  seriesId           String            @map("series_id")
  brand              Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  series             Series            @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  categories         ProductCategory[]
  variants           ProductVariant[]
  images             ProductImage[]
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([publishedAt, createdAt])
  @@index([brandId])
  @@index([seriesId])
  @@index([priceVnd])
  @@index([scale])
  @@index([isPreorder, publishedAt])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  sku         String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  stockOnHand Int      @default(0) @map("stock_on_hand")
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  url       String   @db.VarChar(500)
  altText   String   @map("alt_text") @db.VarChar(240)
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_images")
}
