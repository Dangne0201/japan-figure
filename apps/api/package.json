{
  "name": "@japan-figure/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node apps/api/dist/main.js",
    "start:worker": "node apps/api/dist/worker.js",
    "lint": "eslint src test",
    "test": "jest --runInBand --coverage",
    "test:e2e": "node --max-old-space-size=640 ../../node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "test:watch": "jest --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:reset": "prisma migrate reset --force",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "knowledge:reindex": "ts-node --transpile-only src/knowledge/reindex.ts",
    "chatbot:benchmark": "ts-node --transpile-only src/knowledge/benchmark.ts",
    "chatbot:evaluate": "ts-node --transpile-only src/knowledge/evaluation.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.1",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "jest": "^29.7.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0"
  }
}
