# Copy to .env for local development. Never commit .env or real credentials.

# General
NODE_ENV=development
APP_PORT=8081
# Optional SEO/Open Graph origin for LAN phone access (example: http://192.168.1.25:8081).
# Production must use an HTTPS origin; the API rejects insecure production settings.
# SITE_URL=http://192.168.1.25:8081

# PostgreSQL (local Compose defaults only; choose a unique password for your machine)
POSTGRES_DB=japan_figure
POSTGRES_USER=japan_figure
POSTGRES_PASSWORD=replace-with-a-local-password

# Container-only service URLs; Compose supplies these values to app containers.
DATABASE_URL=postgresql://japan_figure:replace-with-a-local-password@postgres:5432/japan_figure
REDIS_URL=redis://redis:6379

# Local-only host UI for the fake mailbox (SMTP is only exposed on loopback in the dev override)
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Authentication secret (replace the local placeholder with a random value of at least 32 characters)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_ACTION_TOKEN_TTL_HOURS=24
# Keep false for local HTTP; production requires COOKIE_SECURE=true and an HTTPS SITE_URL.
COOKIE_SECURE=false
# Optional values used only by the manual seed service; leave blank to create no admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mailpit (fake mail only; no real email is sent)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@japan-figure.local

# Local LLM provider. Ollama runs on the Windows host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_CHAT_FALLBACK_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3
# Gemini is optional for chat only; Ollama remains the local embedding provider.
LLM_PROVIDER=ollama
# Provider request timeout and retry count.
LLM_REQUEST_TIMEOUT_MS=120000
LLM_RETRY_COUNT=2
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Hybrid knowledge retrieval result threshold and maximum number of chunks.
KNOWLEDGE_RELEVANCE_THRESHOLD=0.42
KNOWLEDGE_TOP_K=4
