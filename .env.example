# Copy to .env for local development. Never commit .env or real credentials.

# General
NODE_ENV=development
APP_PORT=8080
WEB_PORT=3000
API_PORT=3001

# PostgreSQL (local Docker Compose defaults; replace passwords for non-local use)
POSTGRES_DB=japan_figure
POSTGRES_USER=japan_figure
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://japan_figure:change-me-local-only@postgres:5432/japan_figure

# Redis
REDIS_URL=redis://redis:6379

# Auth (use a long random value; never use this example value outside local setup)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret

# Mailpit (fake mail only; no real email is sent)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@japan-figure.local

# Local LLM provider. Ollama runs on the Windows host.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b-instruct
OLLAMA_CHAT_FALLBACK_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBEDDING_MODEL=bge-m3
GEMINI_API_KEY=
